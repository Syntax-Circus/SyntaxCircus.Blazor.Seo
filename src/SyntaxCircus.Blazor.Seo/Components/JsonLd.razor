@namespace SyntaxCircus.Blazor.Seo.Components

@*
    The whole element is one MarkupString: a literal type attribute in Razor is HTML-encoded by the static
    renderer ("application/ld&#x2B;json"). Browsers decode that, but crawlers that match the raw text do not.
    JsonLdSerializer escapes "<", so the payload cannot close the element.
*@
@if (!string.IsNullOrEmpty(_serialized))
{
    @((MarkupString)$"<script type=\"application/ld+json\">{_serialized}</script>")
}

@code {
    [Parameter, EditorRequired] public object? Data { get; set; }

    private string? _serialized;

    protected override void OnParametersSet()
    {
        _serialized = Data is null ? null : JsonLdSerializer.Serialize(Data);
    }
}
